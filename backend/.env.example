APP_NAME="Pro One Control Center"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090
FRONTEND_URL=http://localhost:5190

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pro_one_control_center
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=pro_one_cc_session
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost:5190,127.0.0.1:5190,localhost,127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# false while building the license workflow; set true before production.
CONTROL_CENTER_REQUIRE_MFA=false
CONTROL_CENTER_MFA_ISSUER="Pro One Control Center"
CONTROL_CENTER_MFA_STEP_UP_SECONDS=300
CONTROL_CENTER_LOCKOUT_ATTEMPTS=5
CONTROL_CENTER_LOCKOUT_MINUTES=15

# Ed25519 signing key. Keep the private-key file outside this repository.
CONTROL_CENTER_LICENSE_KEY_ID=
CONTROL_CENTER_LICENSE_PRIVATE_KEY_PATH=
